# ===========================================================
#  3DGS 视频重建流水线 .gitignore
#
#  原则：只提交「源码 + 脚本 + 文档」，所有训练产物/视频/大文件都不进仓库。
#  当前被忽略的内容实测约 1.5GB。
# ===========================================================

# ---------- 训练产物（每个模型约 80~450MB）----------
outputs/
outputs_*/
*.ckpt
*.pt
*.pth

# ---------- 输入视频与 COLMAP 中间产物 ----------
data/
*.mp4
*.mov
*.avi
*.mkv

# ---------- 预览渲染视频 ----------
renders/
renders_*/

# ---------- 网页播放器用的高斯泼溅模型（单个 12MB）----------
# 由 ns-export 按需生成，不入库
web/assets/

# ---------- 环境与安装包 ----------
envs/
tools/
*.whl
*.sh.1

# ---------- 日志与运行时状态 ----------
logs/
*.log
*.status
*.progress
app_state.json

# ---------- 调试脚本（100+ 个，只在本机有意义）----------
debug/

# ---------- 文档中提到但不入库的论文副本 ----------
*.pdf

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
build/
dist/

# ---------- IDE / 系统 ----------
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
desktop.ini

# ---------- 备份与临时 ----------
*.bak
*.tmp
*.orig
*~
